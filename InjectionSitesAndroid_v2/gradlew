#!/usr/bin/env sh
#
# Text-only Gradle bootstrapper. The standard Gradle Wrapper JAR is deliberately
# not committed because this repository host does not accept binary files.
# It downloads the pinned Gradle distribution declared in
# gradle/wrapper/gradle-wrapper.properties into GRADLE_USER_HOME on first use.

set -eu

GRADLE_VERSION="8.7"
DIST_URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_HOME_BASE="${GRADLE_USER_HOME:-"$HOME/.gradle"}"
INSTALL_DIR="$GRADLE_HOME_BASE/bootstrap/gradle-${GRADLE_VERSION}"
GRADLE_BIN="$INSTALL_DIR/gradle-${GRADLE_VERSION}/bin/gradle"
ARCHIVE="$INSTALL_DIR/gradle-${GRADLE_VERSION}-bin.zip"

if [ ! -x "$GRADLE_BIN" ]; then
    mkdir -p "$INSTALL_DIR"
    if [ ! -f "$ARCHIVE" ]; then
        if command -v curl >/dev/null 2>&1; then
            curl --fail --location --silent --show-error "$DIST_URL" --output "$ARCHIVE"
        elif command -v wget >/dev/null 2>&1; then
            wget --quiet --output-document="$ARCHIVE" "$DIST_URL"
        else
            echo "ERROR: curl or wget is required to download Gradle ${GRADLE_VERSION}." >&2
            exit 1
        fi
    fi

    if ! command -v unzip >/dev/null 2>&1; then
        echo "ERROR: unzip is required to extract Gradle ${GRADLE_VERSION}." >&2
        exit 1
    fi
    unzip -q "$ARCHIVE" -d "$INSTALL_DIR"
    rm -f "$ARCHIVE"
fi

cd "$APP_HOME"
exec "$GRADLE_BIN" "$@"
